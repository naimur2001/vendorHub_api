



NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5433/dbname
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
BARGAIN_TTL_MINUTES=30
BARGAIN_ACCEPTED_HOURS=24
CORS_ORIGINS=
TRUST_PROXY=0
# RATE_LIMIT_ENABLED=true   (unset = on in production only)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
APP_URL=http://localhost:3000
# Mail: "log" writes mails to the log (tests need this); "smtp" really sends them
MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Gmail address and a Gmail App Password (never the normal Google password)
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vendors Hub <your-address@gmail.com>"
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10
PUBLIC_API_URL=http://localhost:4000
TRYON_MODE=mock
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
TRYON_DAILY_LIMIT=10
COOKIE_SAMESITE=lax
COOKIE_SECURE=
COOKIE_DOMAIN=